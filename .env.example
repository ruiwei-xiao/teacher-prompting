# Liveblocks server secret for calibration room auth and session tokens.
LIVEBLOCKS_SECRET_KEY=

# Resend API key for calibration activity notices. Unset uses the console/.data fallback.
RESEND_API_KEY=

# From address used when sending calibration notice emails.
CALIBRATION_EMAIL_FROM=

# Shared secret that authenticates the calibration cron tick endpoint.
CRON_SECRET=
